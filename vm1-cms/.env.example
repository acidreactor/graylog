CMS_PORT=8080
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_PASSWORD=wppass
FILEBEAT_VERSION=8.15.3
# Адрес API Graylog. В общей docker-сети lab4-net это имя сервиса graylog,
# на отдельных ВМ - IP второй ВМ, например http://192.168.56.20:9000/api/
GRAYLOG_API_URL=http://graylog:9000/api/
# Токен Sidecar: его печатает контейнер provision на второй ВМ
# (docker compose logs provision | grep SIDECAR_API_TOKEN)
SIDECAR_API_TOKEN=

# Если сборка образа идёт через HTTP-прокси, раскомментируйте и укажите адрес.
# Прокси используется только при сборке (docker compose build).
# HTTP_PROXY=http://proxy.example:3128
# HTTPS_PROXY=http://proxy.example:3128
# NO_PROXY=localhost,127.0.0.1
