GRAYLOG_VERSION=6.1.4
MONGODB_VERSION=6.0.14
OPENSEARCH_VERSION=2.15.0
DATAPREPPER_VERSION=2.10.2

# Секрет для хеширования паролей (не короче 16 символов)
GRAYLOG_PASSWORD_SECRET=lab-secret-change-me-0123456789abcdef
# SHA-256 пароля администратора. Значение ниже - пароль "admin".
# Свой хеш: echo -n 'ваш_пароль' | sha256sum
GRAYLOG_ROOT_PASSWORD_SHA2=8c6976e5b5410415bde908bd4dee15dfb167a9c873fc4bb8a81f6f2ab448a918
# Тот же пароль в открытом виде: нужен только скрипту provision для обращений к API
GRAYLOG_ADMIN_PASSWORD=admin
# Адрес, по которому веб-интерфейс открывается в браузере.
# Если заходите не с этой машины, укажите её IP: http://192.168.56.20:9000/
GRAYLOG_EXTERNAL_URI=http://localhost:9000/

# Размер памяти JVM. Значения по умолчанию (1g) подходят для ВМ с 6+ ГБ RAM.
# Для ноутбука с 8 ГБ раскомментируйте:
# OPENSEARCH_HEAP=-Xms512m -Xmx512m
# GRAYLOG_HEAP=-Xms768m -Xmx768m
